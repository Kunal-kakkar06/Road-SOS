# RoadSOS Emergency Services Application Environment Configuration Template

# Database Connection
# Production: postgresql+asyncpg://roadsos:<password>@<db-host>:5432/roadsos_db
# Development/Testing: sqlite+aiosqlite:///./roadsos.db
DATABASE_URL=postgresql+asyncpg://roadsos:roadsos_password@localhost:5432/roadsos_db

# Environment Mode (production, staging, development)
# Setting ENVIRONMENT=production enforces PostgreSQL and strictly prohibits SQLite
ENVIRONMENT=development

# JWT Secret Key for Authentication
# CHANGE IN PRODUCTION! Must be a long, cryptographically random string.
JWT_SECRET=roadsos-super-secret-key-change-in-production

# CORS Allowed Origin for Frontend Application
FRONTEND_ORIGIN=http://localhost:5173

# SQLAlchemy Connection Pool Configuration
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=True

# Backup Retention Policy (Hours, Days, Weeks)
RETENTION_HOURS=24
RETENTION_DAYS=7
RETENTION_WEEKS=4
